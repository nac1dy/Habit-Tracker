@startuml

title Klassendiagramm – Habit-Tracker

skinparam classAttributeIconSize 0
skinparam linetype ortho

package "Frontend" {
    class "Homepage (page.tsx)" as Homepage <<React>> {
        - habits: Habit[]
        --
        + loadHabits(day: Date): void
        + displayHabits(): void
    }
}

package "Backend" {
    class HabitRouter <<Supabase>> {
        --
        + getHabitsByDay(day: Date): Habit[]
    }

    class HabitRepository <<Repository>> {
        --
        + fetchHabits(day: Date): Habit[]
    }
}

package "Persistenz" {
    class Habit <<Entity>> {
        + id: UUID
        + name: String
        + day: Date
    }
}

Homepage ..> HabitRouter
HabitRouter --> HabitRepository
HabitRepository ..> Habit

@enduml