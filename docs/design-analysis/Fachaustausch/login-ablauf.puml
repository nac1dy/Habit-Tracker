@startuml login-ablauf
' Login vom Absenden des Formulars bis zur Startseite oder Fehlermeldung.
skinparam monochrome true
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
hide footbox

title Login: Ablauf

actor Nutzer
participant "login/page.tsx" as page
participant "actions.ts" as actions
participant "authService.ts" as service
participant "server.ts" as client
participant "Supabase Auth" as auth

Nutzer -> page : E-Mail und Passwort
page -> actions : loginAction() <i>POST</i>
actions -> actions : Eingaben prüfen
actions -> service : signIn()
service -> client : signInWithPassword()
client -> auth : E-Mail und Passwort
auth -> auth : mit bcrypt-Hash vergleichen

alt korrekt
  auth --> client : Access und Refresh Token
  client -> client : setAll(): Cookie setzen
  client --> service : kein Fehler
  service --> actions : { ok: true }
  actions --> page : { ok: true } + Set-Cookie
  page --> Nutzer : Startseite
else falsch oder nicht bestätigt
  auth --> client : Fehlercode
  client --> service : Fehler
  service -> service : toUserMessage()
  service --> actions : { ok: false, message }
  actions --> page : { ok: false, message }
  page --> Nutzer : Fehlermeldung
end

@enduml
