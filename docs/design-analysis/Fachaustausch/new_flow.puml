@startuml current-flow

skinparam monochrome true
skinparam defaultFontSize 12

actor "User" as user
participant "page.tsx" as home
participant "HabitRouter" as svc
participant "HabitRepository" as ctrl
participant "Cloud-Speicher" as repo

user -> home : öffnet Habit-Tracker und filtert
home -> svc : GET /api/habits
svc -> ctrl : getHabits()
ctrl -> repo : SELECT * from Habits WHERE userid, filter
repo -> ctrl : return Habits
ctrl -> svc : return Habits
svc -> home : Habits
home -> home : Filter(filter)
home -> user : showHabits()


alt Kein aktuellen Habit gefunden

home -> home : Filter(filter)
home -> user : showMessageNoCurrentHabits()

end

@enduml