@startuml

skinparam monochrome true
skinparam defaultFontSize 12

actor "User" as user
participant "Home" as home
participant "HabitRouter" as svc
participant "HabitRepository" as repo

user -> home : öffnet Habit-Tracker
home -> svc : GET /api/habits
svc -> repo : SELECT * from Habits
repo -> svc : Return Habits
svc --> home : Habit
home --> user : 200 OK

@enduml